# Copie para server/.env e preencha.
ANTHROPIC_API_KEY=
# Modelo (padrão: claude-opus-5-5)
# AI_MODEL=claude-opus-5-5
# Esforço de raciocínio por fase: low | medium | high | xhigh | max
# AI_EFFORT_ANALYSIS=high
# AI_EFFORT_LESSON=high
# AI_EFFORT_ASSIST=medium
# Saída estruturada: auto | on | off
# AI_STRUCTURED_OUTPUTS=auto
# Fallback automático em caso de recusa (on/off)
# AI_SERVER_FALLBACK=on
# PORT=8787
# HOST=127.0.0.1
# DATA_DIR=data
